<%
  sections = Package::KIND_OPTIONS.filter_map do |kind, label|
    packages = @packages.select { |package| package.kinds.include?(kind) }
    [kind, label, packages] if packages.any?
  end
%>

<div class="min-h-[75vh] bg-gradient-to-b from-sky-50 via-white to-white">
  <div class="w-full py-10">
    <div class="overflow-hidden rounded-[28px] border border-gray-200 bg-white shadow-xl shadow-blue-100/40">

      <div class="relative overflow-hidden bg-gradient-to-r from-blue-600 via-cyan-500 to-sky-500 px-6 py-10 text-white sm:px-10">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white"></div>
          <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-white"></div>
        </div>

        <div class="relative mx-auto max-w-4xl text-center">
          <h1 class="text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
            Servicios
          </h1>

          <p class="mt-4 text-sm leading-6 text-blue-50 sm:text-base">
            En AMID reunimos servicios médicos, ultrasonidos, ginecología y atención especial para que puedas revisar tus opciones y agendar en línea con claridad.
          </p>
        </div>
      </div>

      <div class="space-y-12 px-6 py-10 sm:px-10">

        <% sections.each do |kind, label, packages| %>
          <section>

            <div class="mb-5 max-w-3xl">
              <p class="text-xs font-black uppercase tracking-[.18em] text-blue-600">
                AMID
              </p>

              <h2 class="mt-2 text-2xl font-black text-slate-900">
                <%= label %>
              </h2>
            </div>

            <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
              <% packages.each do |package| %>
                <%= render "shared/featured_package_card",
                      package: package,
                      category_label: label %>
              <% end %>
            </div>

          </section>
        <% end %>

      </div>
    </div>
  </div>
</div>