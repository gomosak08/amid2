<%
  service_groups = amid_public_service_groups(@packages.to_a)
  sections = [
    {
      title: "Servicios",
      description: "Encuentra opciones de atención médica y estudios disponibles en AMID, con información clara para elegir el servicio adecuado y agendar con facilidad.",
      packages: service_groups[:general],
      label: "Servicio"
    },
    {
      title: "Ultrasonidos",
      description: "Estudios de ultrasonido para valoración diagnóstica, seguimiento y revisión de distintas zonas del cuerpo.",
      packages: service_groups[:ultrasounds],
      label: "Ultrasonido"
    },
    {
      title: "Ginecología",
      description: "Servicios ginecológicos orientados al cuidado, prevención y tratamiento de la salud de la mujer.",
      packages: service_groups[:gynecology],
      label: "Ginecología"
    },
    {
      title: "Servicios Especiales",
      description: "Atención complementaria para acompañar tu bienestar de forma integral.",
      packages: service_groups[:special],
      label: "Servicio especial"
    }
  ]
%>

<div class="min-h-[75vh] bg-gradient-to-b from-sky-50 via-white to-white">
  <div class="w-full py-10">
    <div class="overflow-hidden rounded-[28px] border border-gray-200 bg-white shadow-xl shadow-blue-100/40">
      <div class="relative overflow-hidden bg-gradient-to-r from-blue-600 via-cyan-500 to-sky-500 px-6 py-10 text-white sm:px-10">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white"></div>
          <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-white"></div>
        </div>

        <div class="relative mx-auto max-w-4xl text-center">
          <h1 class="text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
            Servicios
          </h1>

          <p class="mt-4 text-sm leading-6 text-blue-50 sm:text-base">
            En AMID reunimos servicios médicos, ultrasonidos, ginecología y atención especial para que puedas revisar tus opciones y agendar en línea con claridad.
          </p>
        </div>
      </div>

      <div class="space-y-12 px-6 py-10 sm:px-10">
        <% sections.each do |section| %>
          <section>
            <div class="mb-5 max-w-3xl">
              <p class="text-xs font-black uppercase tracking-[.18em] text-blue-600">AMID</p>
              <h2 class="mt-2 text-2xl font-black text-slate-900"><%= section[:title] %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= section[:description] %></p>
            </div>

            <% if section[:packages].any? %>
              <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
                <% section[:packages].each do |package| %>
                  <%= render "shared/featured_package_card", package: package, category_label: section[:label] %>
                <% end %>
              </div>
            <% else %>
              <div class="rounded-[24px] border border-dashed border-gray-300 bg-gray-50 px-6 py-10 text-center">
                <h3 class="text-lg font-semibold text-gray-800">No hay servicios disponibles en esta sección</h3>
                <p class="mt-2 text-sm text-gray-500">
                  Por ahora no se encontraron registros para mostrar aquí.
                </p>
              </div>
            <% end %>
          </section>
        <% end %>
      </div>
    </div>
  </div>
</div>
