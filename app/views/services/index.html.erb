<div class="min-h-[75vh] bg-gradient-to-b from-sky-50 via-white to-white">
  <div class="w-full py-10">
    <div class="overflow-hidden rounded-[28px] border border-gray-200 bg-white shadow-xl shadow-blue-100/40">
      
      <!-- Encabezado -->
      <div class="relative overflow-hidden bg-gradient-to-r from-blue-600 via-cyan-500 to-sky-500 px-6 py-10 text-white sm:px-10">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white"></div>
          <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-white"></div>
        </div>

        <div class="relative mx-auto max-w-4xl text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a4 4 0 00-5.656 0L12 17.2l-1.772-1.772a4 4 0 10-5.656 5.656l1.772 1.772a4 4 0 005.656 0l1.772-1.772 1.772 1.772a4 4 0 005.656-5.656z" />
            </svg>
          </div>

          <h1 class="text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
            Servicios
          </h1>

          <p class="mt-3 text-sm leading-6 text-blue-50 sm:text-base">
            Explora nuestros servicios médicos y agenda tu cita de forma rápida y sencilla.
          </p>
        </div>
      </div>

      <!-- Contenido -->
      <div class="px-6 py-10 sm:px-10">
        <% servicios = @packages.where(kind: "servicios") %>

        <% if servicios.any? %>
          <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            <% servicios.each do |package| %>
              <%= render "shared/featured_package_card", package: package %>
            <% end %>
          </div>

        <% else %>

          <div class="rounded-[24px] border border-dashed border-gray-300 bg-gray-50 px-6 py-12 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m2 8H7a2 2 0 01-2-2V7a2 2 0 012-2h3.172a2 2 0 001.414-.586l.828-.828A2 2 0 0113.828 3H17a2 2 0 012 2v14a2 2 0 01-2 2z" />
              </svg>
            </div>

            <h2 class="text-xl font-semibold text-gray-800">No hay servicios disponibles</h2>
            <p class="mt-2 text-sm text-gray-500">
              Por ahora no se encontraron servicios para mostrar.
            </p>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
