<%# ── HOME VERSION 1 (versión completa — hero + pasos + por qué + servicios + CTA) ── %>

<%
  featured_surgeries = @packages.where(kind: "cirugia", featured: true)
  all_featured = featured_services + featured_packages + featured_surgeries
  featured_total = all_featured.count
%>

<style>
.hp{
  --c-primary:#1a56db;
  --c-primary-d:#1741b0;
  --c-accent:#0ea5e9;
  --c-green:#047857;
  --c-green-d:#065f46;
  --c-ink:#0f172a;
  --c-muted:#64748b;
  --c-line:#e2e8f0;
  --r:20px;
}
/* ─ Hero ─ */
.hp-hero{
  position:relative;overflow:hidden;border-radius:28px;
  background:linear-gradient(135deg,#0c3b82 0%,#1a56db 48%,#0ea5e9 100%);
  color:#fff;margin-bottom:2rem;
}
.hp-hero::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at 80% 20%,rgba(255,255,255,.12),transparent 45%),
             radial-gradient(circle at 10% 80%,rgba(14,165,233,.35),transparent 40%);
  pointer-events:none;
}
.hp-hero-inner{
  position:relative;z-index:1;
  display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;
  align-items:center;
  padding:clamp(2rem,5vw,4rem) clamp(1.5rem,4vw,3.5rem);
}
.hp-hero-badge{
  display:inline-flex;align-items:center;gap:.5rem;
  padding:.5rem 1rem;border-radius:999px;
  background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
  font-size:.8rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
  margin-bottom:1.25rem;backdrop-filter:blur(8px);
}
.hp-hero-h1{
  margin:0 0 1rem;font-size:clamp(2.1rem,4.5vw,3.6rem);
  line-height:1.0;font-weight:950;letter-spacing:-.03em;
}
.hp-hero-h1 span{ color:#7dd3fc; }
.hp-hero-sub{
  margin:0 0 2rem;font-size:clamp(1rem,1.4vw,1.15rem);
  line-height:1.7;color:rgba(255,255,255,.88);max-width:52ch;
}
.hp-hero-btns{ display:flex;flex-wrap:wrap;gap:.85rem; }
.hp-btn-cta{
  display:inline-flex;align-items:center;gap:.6rem;
  padding:.95rem 1.6rem;border-radius:14px;font-weight:900;font-size:1rem;
  text-decoration:none;background:#fff;color:var(--c-primary);
  box-shadow:0 12px 28px rgba(0,0,0,.18);transition:transform .18s,box-shadow .18s;
}
.hp-btn-cta:hover{ transform:translateY(-2px);color:var(--c-primary-d); }
.hp-btn-ghost{
  display:inline-flex;align-items:center;gap:.6rem;
  padding:.95rem 1.4rem;border-radius:14px;font-weight:800;font-size:1rem;
  text-decoration:none;background:rgba(255,255,255,.12);color:#fff;
  border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(8px);
  transition:background .18s,transform .18s;
}
.hp-btn-ghost:hover{ background:rgba(255,255,255,.2);color:#fff;transform:translateY(-2px); }
.hp-hero-stats{ display:flex;gap:1.5rem;margin-top:2rem;flex-wrap:wrap; }
.hp-stat{ display:flex;flex-direction:column; }
.hp-stat-num{ font-size:1.7rem;font-weight:950;line-height:1; }
.hp-stat-lbl{ font-size:.8rem;color:rgba(255,255,255,.75);margin-top:.25rem; }
.hp-hero-visual{ display:flex;flex-direction:column;gap:1rem; }
.hp-hero-carousel{
  border-radius:22px;overflow:hidden;
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);
  backdrop-filter:blur(10px);padding:.6rem;
}
.hp-hero-carousel .carousel-item{ border-radius:16px;overflow:hidden; }
.hp-hero-carousel img{ width:100%;aspect-ratio:16/10;object-fit:cover;display:block;border-radius:16px; }
.hp-hero-features{ display:grid;grid-template-columns:1fr 1fr;gap:.75rem; }
.hp-feat{
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);
  border-radius:14px;padding:.85rem 1rem;
  display:flex;align-items:center;gap:.7rem;backdrop-filter:blur(8px);
}
.hp-feat-icon{
  width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.18);
  display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0;
}
.hp-feat-text{ font-size:.85rem;font-weight:700;line-height:1.35; }
/* ─ Shared section styles ─ */
.hp-section-label{
  display:inline-flex;align-items:center;gap:.45rem;
  font-size:.78rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase;
  color:var(--c-primary);margin-bottom:.6rem;
}
.hp-section-title{
  margin:0 0 .5rem;font-size:clamp(1.55rem,2.5vw,2.2rem);
  font-weight:950;line-height:1.08;color:var(--c-ink);letter-spacing:-.025em;
}
.hp-section-sub{ margin:0;color:var(--c-muted);font-size:1rem;line-height:1.65;max-width:58ch; }
/* ─ Highlights ─ */
.hp-highlights{
  margin-bottom:2rem;
  border:1px solid var(--c-line);
  border-radius:var(--r);
  background:#fff;
  padding:clamp(1.5rem,3vw,2.25rem);
  box-shadow:0 8px 24px rgba(15,23,42,.05);
}
.hp-highlights-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1rem;
  margin-top:1.4rem;
}
.hp-highlight{
  display:flex;
  gap:.85rem;
  align-items:flex-start;
  border:1px solid #e5eefb;
  border-radius:16px;
  padding:1rem;
  background:#f8fbff;
}
.hp-highlight i{
  width:38px;
  height:38px;
  border-radius:12px;
  background:#dbeafe;
  color:#1d4ed8;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}
.hp-highlight h3{ margin:0 0 .25rem;font-size:.98rem;font-weight:900;color:var(--c-ink); }
.hp-highlight p{ margin:0;color:var(--c-muted);font-size:.9rem;line-height:1.55; }
/* ─ Services ─ */
.hp-services{ margin-bottom:2rem; }
.hp-services-head{ display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem; }
.hp-see-all{
  display:inline-flex;align-items:center;gap:.5rem;padding:.72rem 1.15rem;border-radius:12px;
  background:linear-gradient(180deg,#047857,#065f46);color:#fff;font-weight:900;font-size:.9rem;text-decoration:none;
  box-shadow:0 10px 22px rgba(4,120,87,.20);
  transition:background .18s,transform .18s;
}
.hp-see-all:hover{ background:linear-gradient(180deg,#065f46,#064e3b);color:#fff;transform:translateY(-1px); }
.hp-service-tabs{ display:flex;gap:.6rem;margin-bottom:1.25rem;flex-wrap:wrap; }
.hp-tab{
  display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1.1rem;border-radius:999px;
  font-weight:800;font-size:.9rem;border:1px solid var(--c-line);background:#fff;color:var(--c-muted);
  cursor:pointer;text-decoration:none;transition:all .18s;
}
.hp-tab.active,.hp-tab:hover{ background:var(--c-green);color:#fff;border-color:var(--c-green); }
.hp-cards-grid{ display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem; }
.hp-empty{ background:#fff;border:1px dashed var(--c-line);border-radius:var(--r);padding:2rem;text-align:center;color:var(--c-muted);font-size:.95rem; }
/* ─ CTA ─ */
.hp-cta-banner{
  border-radius:var(--r);
  background:linear-gradient(120deg,#0c3b82 0%,#1a56db 60%,#0ea5e9 100%);
  color:#fff;padding:clamp(1.8rem,4vw,3rem);
  display:flex;align-items:center;justify-content:space-between;
  gap:2rem;flex-wrap:wrap;margin-bottom:2rem;position:relative;overflow:hidden;
}
.hp-cta-banner::before{
  content:"";position:absolute;right:-60px;top:-60px;width:280px;height:280px;
  border-radius:50%;background:rgba(255,255,255,.07);pointer-events:none;
}
.hp-cta-banner > *{ position:relative;z-index:1; }
.hp-cta-banner h2{ margin:0 0 .5rem;font-size:clamp(1.4rem,2.5vw,2rem);font-weight:950;line-height:1.1; }
.hp-cta-banner p{ margin:0;color:rgba(255,255,255,.85);font-size:1rem;line-height:1.6;max-width:54ch; }
.hp-cta-banner-actions{ display:flex;gap:.85rem;flex-wrap:wrap;flex-shrink:0; }
/* ─ Responsive ─ */
@media(max-width:1200px){
  .hp-cards-grid{ grid-template-columns:repeat(3,1fr); }
}
@media(max-width:900px){
  .hp-hero-inner{ grid-template-columns:1fr; }
  .hp-cards-grid{ grid-template-columns:repeat(2,1fr); }
  .hp-highlights-grid{ grid-template-columns:1fr; }
}
@media(max-width:640px){
  .hp-cards-grid{ grid-template-columns:1fr; }
  .hp-cta-banner{
    text-align:left;
    justify-content:flex-start;
    align-items:stretch;
    gap:1.15rem;
    padding:1.35rem;
    border-radius:18px;
  }
  .hp-cta-banner::before{
    right:-120px;
    top:-100px;
    width:220px;
    height:220px;
  }
  .hp-cta-banner h2{
    font-size:1.45rem;
    line-height:1.16;
    max-width:12ch;
  }
  .hp-cta-banner p{
    font-size:.95rem;
    line-height:1.55;
    max-width:none;
  }
  .hp-cta-banner-actions{
    width:100%;
    justify-content:stretch;
    gap:.65rem;
  }
  .hp-cta-banner-actions .hp-btn-cta,
  .hp-cta-banner-actions .hp-btn-ghost{
    width:100%;
    justify-content:center;
    padding:.88rem 1rem;
  }
}
.hp-booking-section {
  margin-bottom: 2rem;
  border: 1px solid #dbeafe;
  border-radius: var(--r);
  background:
    linear-gradient(180deg, rgba(201, 223, 246, .40), rgba(255, 255, 255, .94)),
    #fff;
  padding: clamp(1.4rem, 3vw, 2.25rem);
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(8, 47, 73, .08);
}

.hp-booking-visual {
  display: flex;
  justify-content: center;
  margin-top: 1.35rem;
}

.hp-booking-stage {
  width: min(100%, 760px);
  border-radius: 22px;
  overflow: hidden;
  background: #f4f9fc;
  box-shadow: 0 18px 42px rgba(8, 47, 73, .14);
}

.hp-booking-screen {
  position: relative;
  width: 100%;
  aspect-ratio: 1200 / 800;
  overflow: hidden;
  background: #06172e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hp-booking-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

@media(max-width:640px){
  .hp-booking-section {
    padding: 1.15rem;
    border-radius: 18px;
  }

  .hp-booking-stage {
    border-radius: 16px;
  }

  .hp-booking-screen {
    aspect-ratio: 4 / 3;
  }
}


</style>

<div class="hp">
  <%# ── HERO ── %>
  <section class="hp-hero">
    <div class="hp-hero-inner">
      <div class="hp-hero-copy">
        <span class="hp-hero-badge">
          <i class="fa-solid fa-shield-heart"></i>
          Atención Médica Integral y Diagnóstica
        </span>
        <h1 class="hp-hero-h1">Tu salud en<br><span>las mejores manos</span></h1>
        <p class="hp-hero-sub">
          En AMID te ofrecemos servicios médicos de alta calidad,
          paquetes personalizados y la facilidad de agendar tu cita en minutos.
          Estamos en Morelia, Michoacán.
        </p>
        <div class="hp-hero-btns">
          <%= link_to new_appointment_path, class: "hp-btn-cta", data: { turbo: false } do %>
            <i class="fa-solid fa-calendar-check"></i> Agendar mi cita
          <% end %>
          <%= link_to services_path, class: "hp-btn-ghost" do %>
            <i class="fa-solid fa-stethoscope"></i> Ver servicios
          <% end %>
        </div>
        <div class="hp-hero-stats">
          <div class="hp-stat">
            <span class="hp-stat-num">Fácil</span>
            <span class="hp-stat-lbl">Agenda en línea</span>
          </div>
          <div class="hp-stat" style="border-left:1px solid rgba(255,255,255,.25);padding-left:1.5rem">
            <span class="hp-stat-num">Digital</span>
            <span class="hp-stat-lbl">Resultados descargables</span>
          </div>
        </div>
      </div>
      <div class="hp-hero-visual">
        <div class="hp-hero-carousel">
          <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4200">
            <div class="carousel-inner">
              <% ["slider1.jpg","slider2.jpg","slider3.jpg","slider4.jpg","slider5.jpg"].each_with_index do |img,idx| %>
                <div class="carousel-item <%= 'active' if idx==0 %>">
                  <%= image_tag img, alt: "AMID", loading: "lazy" %>
                </div>
              <% end %>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon"></span><span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon"></span><span class="visually-hidden">Siguiente</span>
            </button>
          </div>
        </div>
        <div class="hp-hero-features">
          <div class="hp-feat"><div class="hp-feat-icon"><i class="fa-solid fa-user-doctor"></i></div><span class="hp-feat-text">Médicos especializados</span></div>
          <div class="hp-feat"><div class="hp-feat-icon"><i class="fa-solid fa-calendar-check"></i></div><span class="hp-feat-text">Citas en minutos</span></div>
          <div class="hp-feat"><div class="hp-feat-icon"><i class="fa-solid fa-file-arrow-down"></i></div><span class="hp-feat-text">Resultados digitales descargables</span></div>
          <div class="hp-feat">
  <a
    href="https://maps.app.goo.gl/8EUjCSUeeXdcVyo17"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-3 text-inherit no-underline hover:text-blue-600 transition-colors"
  >
    <div class="hp-feat-icon">
      <i class="fa-solid fa-location-dot"></i>
    </div>
    <span class="hp-feat-text">Nueva Chapultepec, Morelia</span>
  </a>
</div>
        </div>
      </div>
    </div>
  </section>

  <%# ── RESUMEN ── %>
  <section class="hp-highlights">
    <div>
      <div class="hp-section-label"><i class="fa-solid fa-star"></i> Lo esencial</div>
      <h2 class="hp-section-title">Agenda fácil, atención clara</h2>
      <p class="hp-section-sub">Reserva tu cita en línea, recibe atención humana y consulta tus resultados desde la página cuando estén disponibles.</p>
    </div>
    <div class="hp-highlights-grid">
      <div class="hp-highlight"><i class="fa-solid fa-calendar-days"></i><div><h3>Agenda en minutos</h3><p>Elige servicio, horario y confirma tus datos desde cualquier dispositivo.</p></div></div>
      <div class="hp-highlight"><i class="fa-solid fa-heart-pulse"></i><div><h3>Atención humana</h3><p>Equipo médico con trato cercano y orientación clara durante tu visita.</p></div></div>
      <div class="hp-highlight"><i class="fa-solid fa-file-arrow-down"></i><div><h3>Resultados digitales</h3><p>Consulta y descarga tus resultados desde la página cuando estén listos.</p></div></div>
    </div>
  </section>

  <%# ── CÓMO AGENDAR ── %>
  <section class="hp-booking-section">
    <div>
      <div class="hp-section-label"><i class="fa-solid fa-calendar-check"></i> Cómo agendar</div>
      <h2 class="hp-section-title">Reserva tu cita paso a paso</h2>
      <p class="hp-section-sub">Una guía visual rápida para entender el proceso antes de entrar al formulario.</p>
    </div>

    <div class="hp-booking-visual" aria-label="Animación de pasos para agendar">
      <div class="hp-booking-stage">
        <div class="hp-booking-screen">
          <%= video_tag "videos/agenda facil.mp4",
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            preload: "metadata",
            class: "hp-booking-video" %>
        </div>
      </div>
    </div>
  </section>

  <%# ── SERVICIOS ── %>
  <section class="hp-services">
    <div class="hp-services-head">
      <div>
        <div class="hp-section-label"><i class="fa-solid fa-stethoscope"></i> Catálogo</div>
        <h2 class="hp-section-title">Servicios y paquetes destacados</h2>
        <p class="hp-section-sub">Selecciona cualquier opción para agendar directamente.</p>
      </div>
      <div style="display:flex;gap:.65rem;flex-wrap:wrap;align-items:center">
        <%= link_to services_path, class: "hp-see-all" do %><i class="fa-solid fa-wave-square"></i> Todos los servicios<% end %>
        <%= link_to packages_path, class: "hp-see-all" do %><i class="fa-solid fa-box-open"></i> Todos los paquetes<% end %>
      </div>
    </div>
    <div class="hp-service-tabs">
      <span class="hp-tab active" data-hptab="all"><i class="fa-solid fa-layer-group"></i> Todo (<%= featured_total %>)</span>
      <span class="hp-tab" data-hptab="servicios"><i class="fa-solid fa-stethoscope"></i> Servicios (<%= featured_services.count %>)</span>
      <span class="hp-tab" data-hptab="paquete"><i class="fa-solid fa-box-open"></i> Paquetes (<%= featured_packages.count %>)</span>
    </div>
    <% if all_featured.any? %>
      <div class="hp-cards-grid" id="hp-cards-grid">
        <% all_featured.each do |package| %>
          <div class="hp-search-item" data-kind="<%= package.kind %>">
            <%= render "shared/featured_package_card", package: package %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="hp-empty">Aún no hay servicios o paquetes destacados disponibles.</div>
    <% end %>
  </section>

  <%# ── CTA ── %>
  <section class="hp-cta-banner">
    <div>
      <h2>¿Listo para cuidar tu salud?</h2>
      <p>Agenda tu cita en minutos o escríbenos por WhatsApp. Estamos aquí para ayudarte.</p>
    </div>
    <div class="hp-cta-banner-actions">
      <%= link_to new_appointment_path, class: "hp-btn-cta", data: { turbo: false } do %><i class="fa-solid fa-calendar-check"></i> Agendar cita ahora<% end %>
      <%= link_to "https://wa.me/524437296999?text=Hola,%20quiero%20informaci%C3%B3n%20sobre%20una%20cita", target: "_blank", rel: "noopener", class: "hp-btn-ghost" do %><i class="fab fa-whatsapp"></i> Escribir por WhatsApp<% end %>
    </div>
  </section>
</div>

<script>
  document.addEventListener("turbo:load", function () {
    var tabs  = document.querySelectorAll("[data-hptab]");
    var items = document.querySelectorAll(".hp-search-item");
    tabs.forEach(function(tab) {
      tab.addEventListener("click", function() {
        var kind = tab.dataset.hptab;
        tabs.forEach(function(t){ t.classList.remove("active"); });
        tab.classList.add("active");
        items.forEach(function(item){
          item.style.display = (kind === "all" || item.dataset.kind === kind) ? "" : "none";
        });
      });
    });
  });
</script>
