<section class="hp-services">
  <div class="hp-services-head">
    <div>
      <div class="hp-section-label">
        <i class="fa-solid fa-stethoscope"></i>
        Catálogo
      </div>

      <h2 class="hp-section-title">Servicios y paquetes destacados</h2>

      <p class="hp-section-sub">
        Selecciona cualquier opción para agendar directamente.
      </p>
    </div>

    <div class="hp-services-actions">
      <%= link_to services_path, class: "hp-see-all" do %>
        <i class="fa-solid fa-wave-square"></i>
        Todos los servicios
      <% end %>

      <%= link_to packages_path, class: "hp-see-all hp-see-all-alt" do %>
        <i class="fa-solid fa-box-open"></i>
        Todos los paquetes
      <% end %>
    </div>
  </div>

  <div class="hp-service-tabs">
    <span class="hp-tab active" data-hptab="all">
      <i class="fa-solid fa-layer-group"></i>
      Todo (<%= featured_total %>)
    </span>

    <span class="hp-tab" data-hptab="servicios">
      <i class="fa-solid fa-stethoscope"></i>
      Servicios (<%= featured_services.count %>)
    </span>

    <span class="hp-tab" data-hptab="paquete">
      <i class="fa-solid fa-box-open"></i>
      Paquetes (<%= featured_packages.count %>)
    </span>
  </div>

  <% if all_featured.any? %>
    <div class="hp-cards-grid" id="hp-cards-grid">
      <% all_featured.each do |package| %>
        <div class="hp-search-item" data-kind="<%= package.kind %>">
          <%= render "shared/featured_package_card", package: package %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="hp-empty">
      <i class="fa-solid fa-folder-open"></i>
      <span>Aún no hay servicios o paquetes destacados disponibles.</span>
    </div>
  <% end %>
</section>