<%
  # ══════════════════════════════════════════
  #  SELECTOR DE VERSIÓN DEL HOME
  #  Cambia el número para elegir la versión:
  #    1 → versión completa (hero + pasos + por qué + servicios + CTA)
  #    2 → versión premium del usuario (stylesheet externo)
  # ══════════════════════════════════════════
  home_version = 1

  featured_services = @packages.select { |package| package.featured? && package.kinds.include?("servicio") }
  featured_packages = @packages.select { |package| package.featured? && package.kinds.include?("paquete") }
%>

<%= render "home/home_v#{home_version}",
         featured_services: featured_services,
         featured_packages: featured_packages %>
