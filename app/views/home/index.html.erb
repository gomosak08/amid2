<%
  # ══════════════════════════════════════════
  #  SELECTOR DE VERSIÓN DEL HOME
  #  Cambia el número para elegir la versión:
  #    1 → versión clínica completa (hero + pasos + por qué + servicios + CTA)
  #    2 → versión premium del usuario (stylesheet externo)
  # ══════════════════════════════════════════
  home_version = 2

  featured_services = @packages.where(kind: "servicios", featured: true)
  featured_packages = @packages.where(kind: "paquete",   featured: true)
%>

<%= render "home/home_v#{home_version}",
         featured_services: featured_services,
         featured_packages: featured_packages %>