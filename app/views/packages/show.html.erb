<!-- app/views/packages/show.html.erb -->

<style>
  .package-show-shell {
    width: 100%;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .package-show-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 2rem;
    align-items: start;
  }

  .package-hero-card,
  .package-info-card,
  .package-description-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.75rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
  }

  .package-hero-wrap {
    padding: 1rem;
    background: linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
  }

  /* CONTENEDOR PERFECTO PARA 1200x800 */
  .package-hero-frame {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 800px;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #fff;
    position: relative;
  }

  .package-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .35s ease;
  }

  .package-hero:hover {
    transform: scale(1.02);
  }

  .package-badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem 1rem;
    border-radius: 9999px;
    background: #eff6ff;
    color: #2563eb;
    font-size: .9rem;
    font-weight: 700;
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.08);
  }

  .package-price-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.4rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    color: #1d4ed8;
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.1;
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.08);
  }

  .package-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    width: 100%;
    min-height: 58px;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: all .2s ease;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.25);
  }

  .package-cta:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(37, 99, 235, 0.32);
  }

  .package-feature {
    display: flex;
    align-items: flex-start;
    gap: .9rem;
    padding: 1rem;
    border-radius: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    transition: all .2s ease;
  }

  .package-feature:hover {
    background: #f1f5f9;
    transform: translateY(-1px);
  }

  .package-feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dbeafe;
    color: #2563eb;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .package-description-text {
    white-space: pre-line;
    color: #475569;
    line-height: 1.9;
    font-size: 1rem;
  }

  .package-section-title {
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  @media (max-width: 1280px) {
    .package-show-grid {
      grid-template-columns: 1fr 380px;
    }
  }

  @media (max-width: 1024px) {
    .package-show-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .package-hero-wrap {
      padding: .75rem;
    }

    .package-info-card,
    .package-description-card {
      padding: 1.25rem !important;
    }

    .package-price-pill {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<div class="package-show-shell w-full mx-auto px-4 md:px-6 py-8">
  <div class="max-w-[1500px] mx-auto">

    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="package-badge mb-4">
        <i class="fa-solid fa-box-open"></i>
        Paquete médico
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-800 tracking-tight leading-tight">
        <%= @package.name %>
      </h1>

      <% if @package.description.present? %>
        <p class="mt-4 text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          Conoce todos los beneficios, detalles y servicios incluidos en este paquete médico.
        </p>
      <% end %>
    </div>

    <div class="package-show-grid">

      <!-- Imagen -->
      <section class="package-hero-card overflow-hidden">
        <% if @package.image.present? %>
          <div class="package-hero-wrap">

            <div class="package-hero-frame">
              <%= image_tag @package.image,
                    alt: @package.name,
                    class: "package-hero" %>
            </div>

          </div>
        <% else %>

          <div class="flex items-center justify-center aspect-[3/2] bg-slate-50 text-slate-400 rounded-[1.5rem]">
            <div class="text-center px-6">

              <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center">
                <i class="fa-regular fa-image text-2xl"></i>
              </div>

              <p class="text-lg font-semibold">
                Imagen no disponible
              </p>

            </div>
          </div>

        <% end %>
      </section>

      <!-- Sidebar -->
      <aside class="space-y-6">

        <!-- Información -->
        <div class="package-info-card p-6 md:p-7">

          <p class="package-section-title mb-3">
            Información del paquete
          </p>

          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-5 leading-tight">
            <%= @package.name %>
          </h2>

          <!-- Precio -->
          <div class="mb-7">
            <div class="text-sm text-slate-500 mb-2">
              Precio
            </div>

            <div class="package-price-pill">
              <%= mxn(@package.price) %>
            </div>
          </div>

          <!-- Features -->
          <div class="space-y-3 mb-7">

            <div class="package-feature">
              <div class="package-feature-icon">
                <i class="fa-solid fa-calendar-check"></i>
              </div>

              <div>
                <div class="font-semibold text-slate-800">
                  Agenda tu cita fácilmente
                </div>

                <div class="text-sm text-slate-500 mt-1">
                  Reserva este paquete en pocos pasos y recibe atención rápida.
                </div>
              </div>
            </div>

            <div class="package-feature">
              <div class="package-feature-icon">
                <i class="fa-solid fa-user-doctor"></i>
              </div>

              <div>
                <div class="font-semibold text-slate-800">
                  Atención profesional
                </div>

                <div class="text-sm text-slate-500 mt-1">
                  Servicio médico claro, organizado y pensado para ti.
                </div>
              </div>
            </div>

            <div class="package-feature">
              <div class="package-feature-icon">
                <i class="fa-solid fa-shield-heart"></i>
              </div>

              <div>
                <div class="font-semibold text-slate-800">
                  Experiencia segura
                </div>

                <div class="text-sm text-slate-500 mt-1">
                  Procesos modernos enfocados en comodidad y confianza.
                </div>
              </div>
            </div>

          </div>

          <!-- CTA -->
          <%= link_to new_appointment_path(package_id: @package.id),
                class: "package-cta" do %>

            <i class="fa-solid fa-calendar-plus"></i>
            Agendar cita

          <% end %>

        </div>

        <!-- Descripción -->
        <% if @package.description.present? %>
          <div class="package-description-card p-6 md:p-7">

            <h3 class="text-xl font-bold text-slate-800 mb-4">
              Descripción
            </h3>

            <div class="package-description-text">
              <%= @package.description %>
            </div>

          </div>
        <% end %>

      </aside>
    </div>
  </div>
</div>