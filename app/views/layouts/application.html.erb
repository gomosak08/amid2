            <%= link_to "https://twitter.com/AtencinMdicaIn1", target: "_blank", class: "footer-social" do %>
              <i class="fab fa-twitter w-5"></i> Twitter
            <% end %>
          </div>
        </div>
      </div>

      <div class="text-center text-sm text-white/90 pt-8 mt-8 border-t border-white/20">
        &copy; <%= Time.current.year %> Atención Médica Integral y Diagnóstica — Todos los derechos reservados.
      </div>
    </div>
  </footer>

  <%= link_to "https://wa.me/524437296999?text=Hola,%20quiero%20informaci%C3%B3n%20sobre%20una%20cita",
    target: "_blank",
    class: "whatsapp-float",
    rel: "noopener" do %>
    <i class="fab fa-whatsapp text-xl"></i>
    <span class="label">WhatsApp</span>
  <% end %>

  <turbo-frame id="flash">
    <%= render "shared/flash" %>
  </turbo-frame>

  <script nonce="<%= content_security_policy_script_nonce if respond_to?(:content_security_policy_script_nonce) %>">
    document.addEventListener("turbo:load", function() {
      var el = document.getElementById("auto-pdf");
      if (!el) return;

      window.location = el.dataset.url;

      try {
        var u = new URL(window.location.href);
        u.searchParams.delete("download");
        history.replaceState({}, document.title, u.toString());
      } catch(e) {}
    });
  </script>
</body>
</html>
