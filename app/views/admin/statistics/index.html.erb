<% status_options = [
  ["Programada", "scheduled"],
  ["Completada", "completed"],
  ["Cancelada por admin", "canceled_by_admin"],
  ["Cancelada por cliente", "canceled_by_client"],
  ["No asistió", "no_show"]
] %>

<div class="min-h-[80vh] bg-slate-50">
  <div class="mx-auto w-full max-w-[1500px] px-4 py-8 sm:px-6 lg:px-8">

    <section class="mb-6 overflow-hidden rounded-[32px] bg-slate-950 shadow-xl shadow-slate-300/60">
      <div class="bg-[radial-gradient(circle_at_top_left,_rgba(56,189,248,0.35),_transparent_30%),linear-gradient(135deg,_#0f172a_0%,_#1d4ed8_55%,_#0891b2_100%)] px-6 py-8 text-white sm:px-8">
        <div class="flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-[0.2em] text-white/80">
              Estadísticas administrativas
            </span>

            <h1 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl">
              Resumen de agenda y operación
            </h1>

            <p class="mt-3 max-w-3xl text-sm leading-6 text-blue-50 sm:text-base">
              Consulta el comportamiento de las citas por periodo, estado, médico, creador y paquete.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 xl:min-w-[560px]">
            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
              <div class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Total</div>
              <div class="mt-2 text-3xl font-black"><%= @summary[:total] %></div>
            </div>

            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
              <div class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Completadas</div>
              <div class="mt-2 text-3xl font-black"><%= @summary[:completed] %></div>
            </div>

            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
              <div class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Canceladas</div>
              <div class="mt-2 text-3xl font-black"><%= @summary[:canceled] %></div>
            </div>

            <div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur">
              <div class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Periodo</div>
              <div class="mt-2 text-sm font-bold leading-5">
                <%= l(@from, format: "%d/%m/%Y") %><br>
                <%= l(@to, format: "%d/%m/%Y") %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-6 overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-lg shadow-slate-200/70">
      <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
        <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h2 class="text-xl font-black text-slate-900">Filtros</h2>
            <p class="mt-1 text-sm text-slate-500">
              Ajusta el periodo y combina filtros para revisar resultados específicos.
            </p>
          </div>

          <%= link_to "Limpiar filtros", admin_statistics_path, class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50" %>
        </div>
      </div>

      <div class="px-6 py-6 sm:px-8">
        <%= form_with url: admin_statistics_path, method: :get, local: true, class: "space-y-6" do %>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
            <div>
              <label class="mb-2 block text-sm font-bold text-slate-700">Desde</label>
              <%= date_field_tag :from, @from, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-700 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
            </div>

            <div>
              <label class="mb-2 block text-sm font-bold text-slate-700">Hasta</label>
              <%= date_field_tag :to, @to, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-700 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
            </div>

            <div class="lg:col-span-2 flex items-end">
              <%= submit_tag "Aplicar filtros", class: "w-full cursor-pointer rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700" %>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
            <div class="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-slate-500">Médicos</h3>

              <div class="grid max-h-64 grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2">
                <% @doctor_options.each do |doctor| %>
                  <% checked = Array(params[:doctor_ids]).map(&:to_s).include?(doctor.id.to_s) %>

                  <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 transition hover:border-blue-300 hover:bg-blue-50">
                    <%= check_box_tag "doctor_ids[]", doctor.id, checked, class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                    <span class="text-sm font-semibold text-slate-800"><%= doctor.name %></span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-slate-500">Agendada por</h3>

              <div class="grid max-h-64 grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2">
                <% checked = Array(params[:creator_filters]).include?("patient") %>

                <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 transition hover:border-fuchsia-300 hover:bg-fuchsia-50">
                  <%= check_box_tag "creator_filters[]", "patient", checked, class: "h-4 w-4 rounded border-slate-300 text-fuchsia-600 focus:ring-fuchsia-500" %>
                  <span class="text-sm font-semibold text-slate-800">Paciente / sin usuario</span>
                </label>

                <% @creator_options.each do |creator| %>
                  <% checked = Array(params[:creator_filters]).include?("user:#{creator.id}") %>
                  <% creator_role = creator.role == "doctor" ? "Médico" : (creator.role == "admin" ? "Admin" : "Asistente") %>
                  <% creator_name = creator.try(:name).presence || creator.email.to_s.split("@").first %>

                  <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 transition hover:border-fuchsia-300 hover:bg-fuchsia-50">
                    <%= check_box_tag "creator_filters[]", "user:#{creator.id}", checked, class: "h-4 w-4 rounded border-slate-300 text-fuchsia-600 focus:ring-fuchsia-500" %>
                    <span class="text-sm font-semibold text-slate-800"><%= "#{creator_role} - #{creator_name}" %></span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-slate-500">Estados</h3>

              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <% status_options.each do |label_text, value| %>
                  <% checked = Array(params[:statuses]).include?(value) %>

                  <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 transition hover:border-emerald-300 hover:bg-emerald-50">
                    <%= check_box_tag "statuses[]", value, checked, class: "h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" %>
                    <span class="text-sm font-semibold text-slate-800"><%= label_text %></span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 class="mb-4 text-sm font-black uppercase tracking-[0.16em] text-slate-500">Paquetes</h3>

              <div class="grid max-h-64 grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2">
                <% @package_options.each do |package| %>
                  <% checked = Array(params[:package_ids]).map(&:to_s).include?(package.id.to_s) %>

                  <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 transition hover:border-amber-300 hover:bg-amber-50">
                    <%= check_box_tag "package_ids[]", package.id, checked, class: "mt-1 h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500" %>

                    <span>
                      <span class="block text-sm font-semibold text-slate-800"><%= package.name %></span>
                      <span class="mt-1 block text-xs text-slate-500"><%= package.kind_labels.join(" · ") %></span>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section class="mb-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60">
        <div class="text-xs font-black uppercase tracking-[0.16em] text-slate-400">Programadas</div>
        <div class="mt-3 text-4xl font-black text-blue-700"><%= @summary[:scheduled] %></div>
        <p class="mt-2 text-sm text-slate-500">Pendientes dentro del periodo filtrado.</p>
      </article>

      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60">
        <div class="text-xs font-black uppercase tracking-[0.16em] text-slate-400">Completadas</div>
        <div class="mt-3 text-4xl font-black text-emerald-700"><%= @summary[:completed] %></div>
        <p class="mt-2 text-sm text-slate-500">Citas atendidas correctamente.</p>
      </article>

      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60">
        <div class="text-xs font-black uppercase tracking-[0.16em] text-slate-400">Canceladas</div>
        <div class="mt-3 text-4xl font-black text-rose-700"><%= @summary[:canceled] %></div>
        <p class="mt-2 text-sm text-slate-500">Canceladas por cliente o administración.</p>
      </article>

      <article class="rounded-[26px] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60">
        <div class="text-xs font-black uppercase tracking-[0.16em] text-slate-400">No show</div>
        <div class="mt-3 text-4xl font-black text-amber-700"><%= @summary[:no_show] %></div>
        <p class="mt-2 text-sm text-slate-500">Pacientes que no asistieron.</p>
      </article>
    </section>

    <section class="space-y-6">
      <article class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-lg shadow-slate-200/70">
        <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
          <h2 class="text-xl font-black text-slate-900">Citas creadas por usuario</h2>
          <p class="mt-1 text-sm text-slate-500">
            Muestra quién está registrando citas y el avance de cada usuario.
          </p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <% if @appointments_by_creator.any? %>
            <div class="overflow-x-auto rounded-[24px] border border-slate-200">
              <table class="min-w-full">
                <thead class="bg-slate-50">
                  <tr>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Usuario</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Total</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Programadas</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Completadas</th>
                  </tr>
                </thead>

                <tbody class="divide-y divide-slate-200 bg-white">
                  <% @appointments_by_creator.each do |row| %>
                    <tr class="transition hover:bg-slate-50">
                      <td class="px-5 py-4 text-sm font-bold text-slate-800 whitespace-nowrap"><%= row[:creator_label] %></td>
                      <td class="px-5 py-4 text-sm font-black text-slate-900"><%= row[:total] %></td>
                      <td class="px-5 py-4 text-sm font-bold text-blue-700"><%= row[:scheduled] %></td>
                      <td class="px-5 py-4 text-sm font-bold text-emerald-700"><%= row[:completed] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center text-slate-500">
              No hay creadores que coincidan con el filtro actual.
            </div>
          <% end %>
        </div>
      </article>

      <article class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-lg shadow-slate-200/70">
        <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
          <h2 class="text-xl font-black text-slate-900">Desempeño por médico</h2>
          <p class="mt-1 text-sm text-slate-500">
            Compara actividad, citas completadas y cancelaciones por médico.
          </p>
        </div>

        <div class="px-6 py-5 sm:px-8">
          <% if @appointments_by_doctor.any? %>
            <div class="overflow-x-auto rounded-[24px] border border-slate-200">
              <table class="min-w-full">
                <thead class="bg-slate-50">
                  <tr>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Médico</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Total</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Completadas</th>
                    <th class="px-5 py-4 text-left text-xs font-black uppercase tracking-[0.16em] text-slate-500 whitespace-nowrap">Canceladas</th>
                  </tr>
                </thead>

                <tbody class="divide-y divide-slate-200 bg-white">
                  <% @appointments_by_doctor.each do |row| %>
                    <tr class="transition hover:bg-slate-50">
                      <td class="px-5 py-4 text-sm font-bold text-slate-800 whitespace-nowrap"><%= row[:doctor_name] %></td>
                      <td class="px-5 py-4 text-sm font-black text-slate-900"><%= row[:total] %></td>
                      <td class="px-5 py-4 text-sm font-bold text-emerald-700"><%= row[:completed] %></td>
                      <td class="px-5 py-4 text-sm font-bold text-rose-700"><%= row[:canceled] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center text-slate-500">
              No hay datos de médicos para ese filtro.
            </div>
          <% end %>
        </div>
      </article>
    </section>
  </div>
</div>